# DevMesh Gateway Configuration
#
# Copy this file to gateway.yaml and edit to match your infrastructure.
# Environment variables can be used with ${VAR_NAME:-default} syntax.

# Rate limiting settings
rate_limits:
  requests_per_minute_global: 1000
  requests_per_minute_per_user: 100
  requests_per_hour_per_user: 2000
  max_tokens_per_request: 32768
  burst_limit: 60

# Embedding admission queue: embedding bursts wait for rate-limit
# headroom instead of getting 429s (chat stays fail-fast). 429 only when
# the queue is full or a request waits past max_wait_seconds.
# Voice/image/video limits and metering (D-021)
media:
  max_upload_mb: 25          # transcription uploads; larger -> 413
  max_tts_characters: 4096   # text-to-speech input; longer -> 422
  token_equivalents:         # budgets are token-based; media converts at these rates
    tts_character: 0.25      # ~4 characters per token
    stt_audio_second: 10.0

# Circuit breaker per endpoint (D-031): after N consecutive connection
# errors, timeouts or 5xx (never 4xx) the endpoint is skipped instantly;
# after the cooldown one probe request is let through.
circuit_breaker:
  failure_threshold: 5
  cooldown_seconds: 15.0

embedding_queue:
  enabled: true
  max_pending: 500
  max_wait_seconds: 30.0

# =============================================================================
# Token Budgets (optional)
# Daily token quotas per API key with model-tier cost multipliers.
# Tiers use glob patterns — adapts as models change without code changes.
# =============================================================================

# token_budgets:
#   enabled: false
#   default_daily_limit: 1000000         # 1M weighted tokens/day per key (0 = unlimited)
#   default_cost_multiplier: 5.0         # Unknown models default to 5x until classified
#   enforce_pre_request: true            # Reject before dispatch if budget blown
#
#   # Define cost tiers (just names and multipliers)
#   model_tiers:
#     - name: frontier
#       cost_multiplier: 15.0
#       daily_limit: 500000              # Optional: global cap across all keys
#     - name: midrange
#       cost_multiplier: 3.0
#     - name: standard
#       cost_multiplier: 1.0
#     - name: embedding
#       cost_multiplier: 0.1
#
#   # Assign models to tiers (exact names or globs)
#   # Manage at runtime via POST /api/budget/assignments — no restart needed
#   model_assignments:
#     - { model: "phi4:14b",          tier: midrange }
#     - { model: "llama3.1:8b",       tier: standard }
#     - { model: "llama3.1:70b",      tier: frontier }
#     - { model: "*embed*",           tier: embedding }

# =============================================================================
# Endpoints Configuration
# Add your GPU nodes / inference runtimes here
# =============================================================================

endpoints:
  # Example: Local Ollama instance
  - name: local-ollama
    type: ollama
    url: http://localhost:11434
    enabled: true
    # Request timeout; for streams, how long to wait for the FIRST chunk
    # (cold model loads can be slow)
    timeout: 120.0
    # Streams only: longest silence allowed between chunks once the first
    # has arrived. Longer means the stream is dead, not slow (default 60)
    stream_idle_timeout: 60.0
    max_retries: 3
    labels:
      tier: primary
      location: local

  # Example: vLLM endpoint (OpenAI-compatible serving)
  # - name: vllm-node
  #   type: vllm
  #   url: http://192.168.1.100:8000
  #   enabled: true
  #   timeout: 300.0

  # Example: Second GPU node
  # - name: gpu-node-2
  #   type: ollama
  #   url: http://192.168.1.100:11434
  #   enabled: true
  #   timeout: 120.0
  #   max_retries: 3
  #   labels:
  #     tier: primary

  # Voice endpoints (any engine speaking OpenAI's audio API; see
  # docs/MEDIA_ENGINES.md). type is the request style, capabilities say what
  # it serves. Keep these engines on a private network: most have no auth.
  #
  # Text-to-speech, e.g. Kokoro-FastAPI:
  # - name: kokoro
  #   type: openai
  #   url: http://192.168.1.100:8880
  #   capabilities: [tts]
  #   profile: kokoro          # optional: config/profiles/kokoro.yaml adds voice
  #                            # languages/genders, blending and speed ranges
  #   # voices: [alpha, beta]  # only for engines that can't list their own
  #
  # Speech-to-text, e.g. speaches (faster-whisper) or vLLM with vllm[audio]:
  # - name: whisper
  #   type: openai
  #   url: http://192.168.1.100:8000
  #   timeout: 600.0          # long recordings take a while
  #   capabilities: [stt]
  #   profile: speaches        # Whisper language list for the dashboard

# =============================================================================
# Environments
# Control which endpoints and models are available
# =============================================================================

environments:
  - name: dev
    # In dev, allow all discovered models from all endpoints
    allow_all_discovered: true

  - name: prod
    # In prod, only approved models
    approved_models:
      - phi4:14b
      - llama3.2:*
      - qwen2.5:*

# =============================================================================
# Resolution Policy
# Model -> Endpoint mapping when a model exists on multiple endpoints
# =============================================================================

resolution:
  endpoint_priority:
    - local-ollama
    # - gpu-node-2
  ambiguous_behavior: first_priority

# =============================================================================
# Authentication
# API keys with optional per-client endpoint routing
# Set keys via environment variables to avoid committing secrets.
# =============================================================================

auth:
  enabled: true
  api_keys:
    # Example: Pin a client to a specific endpoint
    - key: "${GATEWAY_KEY_APP1}"
      client_id: my-app
      description: "My application"
      # target_endpoint: gpu-node-2  # Optional: route all traffic to this endpoint

    # Example: General development key
    - key: "${GATEWAY_KEY_DEV}"
      client_id: dev-user
      description: "Development testing"

  # Keyless inference (stock Ollama/OpenAI clients that send no key).
  # Allowed by default, but unrestricted keyless access lets any client drop
  # its key to bypass per-key limits. Disable it, or fence it in:
  # anonymous:
  #   enabled: true
  #   allowed_models: ["llama3.1:*"]
  #   allowed_endpoints: [gpu-node-1]
  #   rate_limit_rpm: 30   # shared by all keyless traffic
