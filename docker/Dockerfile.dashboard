# Dashboard Dockerfile - Multi-stage build
# Stage 1: Build the Vite React app
FROM node:20-slim AS build

WORKDIR /app

# Copy package files first for layer caching
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm install

# Copy source and build. Empty VITE_API_URL = same origin: nginx below proxies
# the API, so the built app works from whatever address the browser used
COPY dashboard/ .
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Stage 2: static files + API proxy
FROM nginx:1.27-alpine

COPY docker/nginx-dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 5174

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5174/ >/dev/null || exit 1
