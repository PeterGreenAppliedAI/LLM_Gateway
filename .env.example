# DevMesh LLM Gateway - Environment Variables
# Copy to .env and edit as needed.

# --- Server ---
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8001

# --- Database ---
# SQLite (default, zero config):
GATEWAY_DB_URL=sqlite+aiosqlite:///data/gateway.db
# PostgreSQL:
# GATEWAY_DB_URL=postgresql+asyncpg://user:pass@localhost:5432/gateway

# Store request/response bodies in audit log (privacy sensitive)
# GATEWAY_DB_STORE_REQUEST_BODY=false
# GATEWAY_DB_STORE_RESPONSE_BODY=false

# --- Guard Model (shadow security analysis) ---
# GATEWAY_GUARD_ENABLED=false
# GATEWAY_GUARD_MODEL_NAME=ibm/granite3.2-guardian:5b
# GATEWAY_GUARD_BASE_URL=http://localhost:11434
# GATEWAY_GUARD_TIMEOUT=15.0

# --- Authentication ---
# API key for general authentication
# GATEWAY_API_KEY=your-api-key-here
# Operator key for the dashboard, key management, budgets and security labeling.
# Required for those routes when auth.enabled is true (they return 403 without it).
# GATEWAY_ADMIN_API_KEY=your-admin-secret-here

# --- Access modes (D-042) ---
# Test mode: keyless inference and dashboard from GATEWAY_DEV_NETWORKS, whatever
# the auth config says (./start-gateway.sh --dev sets this). Never in production.
# GATEWAY_DEV_MODE=false
# GATEWAY_DEV_NETWORKS=127.0.0.0/8,::1/128
# Refuse to start with test mode on, auth off, no admin key, or open keyless access
# GATEWAY_PROFILE=production

# --- Security ---
# IPs to skip security scanning (JSON list)
# GATEWAY_SECURITY_SCAN_ALLOWLIST_IPS=["10.0.0.1"]
# What security scans keep of the prompt: none (default), flagged, all.
# Kept messages are always PII-redacted.
# GATEWAY_SECURITY_STORE_MESSAGES=none
# GATEWAY_SECURITY_RETENTION_DAYS=90

# --- PII Detection & Scrubbing ---
# GATEWAY_PII_ENABLED=false
# GATEWAY_PII_SCRUB_ENABLED=false
# GATEWAY_PII_SCRUB_ROUTES=["/v1/chat/completions","/api/chat"]

# --- CORS (dashboard URLs) ---
# GATEWAY_CORS_ORIGINS=["http://localhost:5174","http://192.168.1.100:5174"]

# --- API Keys (referenced in gateway.yaml) ---
# No fallback defaults in gateway.yaml. If a variable is unset the gateway
# still boots — that API key is disabled with a warning in the log:
GATEWAY_KEY_ESTIMATOR=your-estimator-key-here
GATEWAY_KEY_DISCORD=your-discord-bot-key-here
GATEWAY_KEY_DEV=your-dev-key-here

# --- Dashboard (set in dashboard/.env) ---
# VITE_API_URL=http://localhost:8001
